# Keys stay on the server. Never put them in static/ or content/.
AI_ENABLED=false
DEPLOYMENT_AUDIENCE=local-adult-pilot
GEMINI_BILLING_DISABLED=false
GEMINI_VERIFIED_UNTIL=
GROQ_BILLING_DISABLED=false
GROQ_VERIFIED_UNTIL=
CLOUDFLARE_BILLING_DISABLED=false
CLOUDFLARE_VERIFIED_UNTIL=
# Attestations are ISO UTC timestamps no more than 8 days ahead.
GEMINI_API_KEY=your-existing-key
# Copy the currently eligible Flash model and actual free limits from AI Studio.
REVIEW_PROVIDER=groq
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_AUDIENCE_ELIGIBLE=false
GEMINI_RPM=0
GEMINI_TPM=0
GEMINI_RPD=0
# Public-site strategy. Enable only after confirming Groq Free, billing disabled,
# and the current organization limits. Limits below are ceilings, not guarantees.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
GROQ_RPM=0
GROQ_TPM=0
GROQ_RPD=0
GROQ_TPD=0
# Reference Groq Free limits verified 2026-11-20: 30 RPM, 1,000 RPD,
# 8,000 TPM, 200,000 TPD; your organization may differ.
# Optional humor audition. Never enable a paid Workers account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_ROAST_RPM=0
CLOUDFLARE_NEURONS_PER_DAY=0
# Half-tier profile after verification: Groq 15 RPM / 4000 TPM / 500 RPD /
# 100000 TPD; Cloudflare 150 RPM / 5000 conservatively reserved neurons daily.
# CLOUDFLARE_ROAST_RPD=0 means no extra request/day cap; neuron budget still applies.
CLOUDFLARE_ROAST_RPD=
QUOTA_LIMITS_KIND=
# Enable only after verifying billing is disabled, current free model eligibility,
# allowed region, and an adult professional/business audience under provider terms.
GOOGLE_CLIENT_ID=
# Comma-separated Google sub identifiers, never public email addresses.
ADMIN_GOOGLE_SUBS=
# Optional. Read-only GitHub token (fine-grained, public repositories only, no
# permissions). Anonymous use allows 60 GitHub API requests/hour per server IP.
GITHUB_TOKEN=
SLOP_DB=data/slopguard.sqlite3
